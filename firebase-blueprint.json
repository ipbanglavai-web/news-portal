        "number": { "type": "string" },
        "nid": { "type": "string" },
        "dateOfBirth": { "type": "string" },
        "gmail": { "type": "string" },
        "password": { "type": "string" },
        "newPassword": { "type": "string" },
        "permissions": {
          "type": "object",
          "properties": {
            "fullControl": { "type": "boolean" },
            "newsManagement": { "type": "boolean" },
            "categoryManagement": { "type": "boolean" },
            "adRequests": { "type": "boolean" },
            "userSubmissions": { "type": "boolean" }
          },
          "required": ["fullControl", "newsManagement", "categoryManagement", "adRequests", "userSubmissions"]
